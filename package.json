{
    "name": "roadside_station_maps",
    "version": "0.1.0",
    "type": "module",
    "files": [
        "data",
        "html"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tk0miya/roadside_station_maps"
    },
    "main": "html/js/bundle.js",
    "imports": {
        "#shared/*": "./src/shared/*.ts",
        "#test-utils/auth": "./src/test-utils/auth.tsx",
        "#test-utils/*": "./src/test-utils/*.ts"
    },
    "scripts": {
        "start": "node --import tsx esbuild.config.ts --watch",
        "build": "node --import tsx esbuild.config.ts",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
        "serve": "node --import tsx esbuild.config.ts --serve",
        "dev": "npm run serve",
        "dev:backend": "wrangler dev",
        "deploy:backend": "wrangler deploy --env production",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate": "wrangler d1 migrations apply DB --remote --env production",
        "plan": "node --import tsx src/scripts/plan.ts",
        "generate:cities": "NODE_USE_ENV_PROXY=1 node --import tsx src/scripts/generate-cities.ts",
        "generate:stations": "NODE_USE_ENV_PROXY=1 node --import tsx src/scripts/generate-stationlist.ts",
        "test": "NODE_USE_ENV_PROXY=1 vitest",
        "ci": "npm run lint && npm run typecheck && npm test"
    },
    "dependencies": {
        "@react-oauth/google": "^0.13.5",
        "cheerio": "^1.2.0",
        "csv-parse": "^7.0.2",
        "fflate": "^0.8.3",
        "hono": "^4.13.7",
        "jaconv": "^1.1.2",
        "jose": "^6.2.12",
        "query-string": "^9.5.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@cloudflare/workers-types": "^5.20260809.1",
        "@testing-library/react": "^16.3.3",
        "@types/cheerio": "^1.0.0",
        "@types/google.maps": "^3.66.2",
        "@types/node": "^24.13.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "jsdom": "^30.0.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0",
        "wrangler": "^4.131.0"
    }
}
